    "fields": [
      {
        "id": "f_taxpayer_name",
        "label": "Taxpayer name",
        "lineRef": "Name field",
        "page": 1,
        "position": { "x": 54, "y": 96, "width": 260, "height": 14 },
        "type": "text",
        "format": { "fontFamily": "Helvetica", "fontSize": 10 },
        "dataBinding": { "path": "$.taxpayer.firstName + ' ' + $.taxpayer.lastName" }
      },
      {
        "id": "f_se_business_ein_masked",
        "label": "Primary business EIN, masked for the preparer-facing courtesy copy",
        "lineRef": "Schedule C header (masked)",
        "page": 1,
        "position": { "x": 400, "y": 96, "width": 90, "height": 14 },
        "type": "ein",
        "format": { "maskAllButLast4": true, "fontFamily": "Courier", "fontSize": 10 },
        "dataBinding": { "path": "$.income.selfEmployment.businesses[0].ein" }
      },

      {
        "id": "f_se_income_total",
        "label": "Schedule C gross receipts -- sum across ALL businesses' ALL invoices (2-level wildcard)",
        "lineRef": "Sch C, Line 1",
        "page": 1,
        "position": { "x": 452, "y": 150, "width": 90, "height": 14 },
        "type": "currency",
        "format": { "decimalPlaces": 2, "align": "right" },
        "dataBinding": { "path": "$.income.selfEmployment.businesses[*].invoices[*].amount", "transform": "sum", "fallback": 0 }
      },
      {
        "id": "f_se_expenses_total",
        "label": "Schedule C total expenses -- sum across ALL businesses' ALL expense line items",
        "lineRef": "Sch C, Line 28",
        "page": 1,
        "position": { "x": 452, "y": 168, "width": 90, "height": 14 },
        "type": "currency",
        "format": { "decimalPlaces": 2, "align": "right" },
        "dataBinding": { "path": "$.income.selfEmployment.businesses[*].expenses[*].amount", "transform": "sum", "fallback": 0 }
      },
      {
        "id": "f_se_net_profit",
        "label": "Schedule C net profit -- chained compute over the two fields above",
        "lineRef": "Sch C, Line 31",
        "page": 1,
        "position": { "x": 452, "y": 186, "width": 90, "height": 14 },
        "type": "computed",
        "format": { "decimalPlaces": 2, "align": "right", "negativeStyle": "parentheses" },
        "dataBinding": { "computeExpression": "subtract(f_se_income_total, f_se_expenses_total)" }
      },

      {
        "id": "f_k1_partnership_income",
        "label": "Schedule E, Part II -- ordinary income from PARTNERSHIP K-1s only (S-corps reported on a separate line, so this uses a JSONPath filter predicate, not a plain wildcard)",
        "lineRef": "Sch E, Part II, Col (h), partnerships",
        "page": 1,
        "position": { "x": 452, "y": 220, "width": 90, "height": 14 },
        "type": "currency",
        "format": { "decimalPlaces": 2, "align": "right" },
        "dataBinding": { "path": "$.income.partnershipK1[?(@.entityType=='partnership')].ordinaryIncome", "transform": "sum", "fallback": 0 }
      },

      {
        "id": "f_rental_income_total",
        "label": "Helper field: total rents received across all properties (not itself printed as a box on a real form -- feeds the next computed field)",
        "lineRef": "(internal helper)",
        "page": 1,
        "position": { "x": 452, "y": 254, "width": 90, "height": 14 },
        "type": "currency",
        "format": { "decimalPlaces": 2, "align": "right" },
        "dataBinding": { "path": "$.income.rental.properties[*].rentsReceived", "transform": "sum", "fallback": 0 }
      },
      {
        "id": "f_rental_expenses_total",
        "label": "Helper field: total rental expenses across all properties, all categories (2-level wildcard, same pattern as Schedule C above)",
        "lineRef": "(internal helper)",
        "page": 1,
        "position": { "x": 452, "y": 272, "width": 90, "height": 14 },
        "type": "currency",
        "format": { "decimalPlaces": 2, "align": "right" },
        "dataBinding": { "path": "$.income.rental.properties[*].expenses[*].amount", "transform": "sum", "fallback": 0 }
      },
      {
        "id": "f_rental_net_total",
        "label": "Schedule E total net rental income -- computed from the two helper fields above",
        "lineRef": "Sch E, Line 26",
        "page": 1,
        "position": { "x": 452, "y": 290, "width": 90, "height": 14 },
        "type": "computed",
        "format": { "decimalPlaces": 2, "align": "right", "negativeStyle": "parentheses" },
        "dataBinding": { "computeExpression": "subtract(f_rental_income_total, f_rental_expenses_total)" }
      },

      {
        "id": "f_wages",
        "label": "1040 Line 1a wages",
        "lineRef": "1040, Line 1a",
        "page": 1,
        "position": { "x": 452, "y": 348, "width": 90, "height": 14 },
        "type": "currency",
        "format": { "decimalPlaces": 2, "align": "right" },
        "dataBinding": { "path": "$.income.w2[*].box1Wages", "transform": "sum", "fallback": 0 }
      },
      {
        "id": "f_total_income_line9",
        "label": "1040 Line 9: Total income -- a computed field chained on top of THREE other computed/aggregated fields. NOTE: this MUST appear after f_wages, f_se_net_profit, f_k1_partnership_income, and f_rental_net_total in this array -- the reference engine evaluates fields strictly top-to-bottom with no dependency graph, so a computeExpression can only reference fields already resolved earlier in the list. See SPEC.md future enhancements re: a topological-sort upgrade.",
        "lineRef": "1040, Line 9",
        "page": 1,
        "position": { "x": 452, "y": 330, "width": 90, "height": 14 },
        "type": "computed",
        "format": { "decimalPlaces": 2, "align": "right", "negativeStyle": "parentheses" },
        "dataBinding": { "computeExpression": "sum(f_wages, f_se_net_profit, f_k1_partnership_income, f_rental_net_total)" }
      },

      {
        "id": "f_foreign_account_flag",
        "label": "FBAR-style informational checkbox: 'yes' only if the AGGREGATE value of all foreign accounts exceeds $10,000 at any point -- a numeric-threshold condition on a summed nested array, not a per-account check",
        "lineRef": "Schedule B, Part III, Line 7a",
        "page": 1,
        "position": { "x": 452, "y": 380, "width": 12, "height": 12 },
        "type": "checkbox",
        "format": { "markGlyph": "X" },
        "dataBinding": {
          "path": "$.filingStatus",
          "condition": "sum($.income.foreignAccounts[*].maxValue) > 10000"
        }
      }
    ],

