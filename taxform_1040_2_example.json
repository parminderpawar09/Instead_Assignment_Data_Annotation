            "transform": "sum",
            "_comment": "field is a JSONPath RELATIVE TO THIS ROW, aggregated with transform -- exactly like a top-level dataBinding, just scoped to one array element."
          },
          {
            "id": "netIncome",
            "x": 400, "width": 80, "type": "currency",
            "field": "computed:rentsReceived-expensesTotal",
            "format": { "negativeStyle": "parentheses" },
            "_comment": "computed columns reference SIBLING COLUMN IDs already resolved earlier in the same row, not a raw data-set path."
          }
        ]
      }
    ]
  },

